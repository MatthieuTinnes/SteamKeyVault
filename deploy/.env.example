# Configuration of a deployed environment.

# prod | preprod — names the compose project, the containers and the Traefik routers.
ENVIRONMENT=prod

# Frontend and API domains. CORS, CSRF, ALLOWED_HOSTS, FRONTEND_URL and the
# API URL used by the frontend are derived from them in docker-compose.yml.
DOMAIN=steamkeyvault.com
API_DOMAIN=api.steamkeyvault.com
# CSRF cookie shared between the frontend and the API.
CSRF_COOKIE_DOMAIN=.steamkeyvault.com

# Traefik middlewares (declared in Traefik's file configuration): frontend and
# API, then the API's /admin (always restricted to my IP).
TRAEFIK_MIDDLEWARES=secHeaders@file,crowdsec-bouncer@file
TRAEFIK_ADMIN_MIDDLEWARES=secHeaders@file,crowdsec-bouncer@file,allow-only-my-ip@file

# GHCR image tag: `latest` (latest release) or `preprod` (latest commit on
# main). To roll back to a given version: <version> (e.g. 1.2.0) /
# preprod-<short sha> in the stack's environment, then Deploy in Komodo.
IMAGE_TAG=latest

# Persistent data (PostgreSQL).
DATA_DIR=/data/steamkeyvault

# PostgreSQL — must match the existing database in DATA_DIR.
POSTGRES_USER=steamkeyvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=steamkeyvault

# Django
SECRET_KEY=change-me
LOG_LEVEL=INFO
STEAM_API_KEY=change-me

# Cloudflare Turnstile (registration)
TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Gotify (error alerts)
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=change-me
